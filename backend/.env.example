PORT=4310
APP_BASE_URL=http://localhost:4310
ALLOWED_ORIGINS=*
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_DEFAULT_MODEL=gpt-5-mini
OPENAI_FREE_MODEL=gpt-5-nano
OPENAI_CHAT_FALLBACK_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=20000
IP_QUOTA_SALT=<SET_RANDOM_SECRET_FOR_IP_HASH>
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=https://polite-message-rewriter-production.up.railway.app/api/auth/google/callback

TOSS_CLIENT_KEY=<YOUR_TOSS_CLIENT_KEY>
TOSS_SECRET_KEY=<YOUR_TOSS_SECRET_KEY>
BILLING_CHECKOUT_ENABLED=false

BILLING_CURRENCY=krw
