{
  "manifest_version": 3,
  "name": "Polite Message Rewriter",
  "version": "1.0.0",
  "description": "거친 문장을 상황에 맞는 정중한 한국어 문장으로 변환합니다.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Polite Rewriter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["storage", "clipboardWrite", "tabs"],
  "host_permissions": [
    "http://localhost:4310/*",
    "https://*.railway.app/*",
    "https://api.politemessage.example/*"
  ]
}
